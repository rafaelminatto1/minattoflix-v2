{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minattoflix-v2",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false
  },
  "limits": { "cpu_ms": 10000 },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WatchPartyRoom"]
    }
  ],
  "vars": {
    "COST_MODE": "restricted",
    "AUTO_SCAN_ENABLED": "false",
    "ALLOWED_ORIGINS": "capacitor://localhost,http://localhost,https://localhost",
    "DEFAULT_GDRIVE_FOLDER_ID": "12ttfjMP_2MCPvOLiy8bei0oFLa-8UBT3",
    "DEFAULT_ONEDRIVE_SHARE_URL": "https://1drv.ms/f/c/91785c84c5b944af/IgDNDRlmhJB5SZnxsprKGgFyAQ1LqZYj_kdyOwsgLwljI5g?e=HWuHmN",
    "GDRIVE_API_KEY": "",
    "TMDB_API_KEY": ""
  }
}
