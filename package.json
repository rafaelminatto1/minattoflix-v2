{
  "name": "minattoflix-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "dev:local": "vite --mode offline",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:native": "vite build --config vite.config.native.ts",
    "ios:add": "npm run build:native && cap add ios --packagemanager SPM",
    "ios:prepare": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@mediabunny/ac3": "^1.61.3",
    "@neondatabase/serverless": "^1.0.0",
    "hls.js": "^1.7.3",
    "hono": "^4.7.4",
    "lucide-react": "^0.487.0",
    "mediabunny": "^1.8.0",
    "mux.js": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.0.5",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wrangler": "^4.4.0"
  }
}
